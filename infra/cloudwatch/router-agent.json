{
  "agent": { "run_as_user": "root" },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          { "file_path": "/var/log/genkart/router.log",  "log_group_name": "/genkart/router",  "log_stream_name": "{instance_id}" },
          { "file_path": "/var/log/genkart/encoder.log", "log_group_name": "/genkart/encoder", "log_stream_name": "{instance_id}" },
          { "file_path": "/var/log/genkart/ingest.log",  "log_group_name": "/genkart/ingest",  "log_stream_name": "{instance_id}" }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "GenKart/Host",
    "append_dimensions": { "InstanceId": "${aws:InstanceId}" },
    "metrics_collected": {
      "mem":  { "measurement": ["mem_used_percent"], "metrics_collection_interval": 60 },
      "disk": { "measurement": ["used_percent"], "resources": ["/"], "metrics_collection_interval": 60 }
    }
  }
}
