{
  "agent": { "run_as_user": "root" },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          { "file_path": "/var/log/genkart/shard-*.log", "log_group_name": "/genkart/shard", "log_stream_name": "{instance_id}", "retention_in_days": 7 }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "GenKart/Host",
    "append_dimensions": { "InstanceId": "${aws:InstanceId}" },
    "metrics_collected": {
      "mem":  { "measurement": ["mem_used_percent"], "metrics_collection_interval": 60 },
      "disk": { "measurement": ["used_percent"], "resources": ["/"], "metrics_collection_interval": 60 }
    }
  }
}
