# Copy to .env (it is gitignored). Reading public Hugging Face datasets needs no key.
# Only if you later use a gated dataset or higher rate limits:
# HF_TOKEN=
# Only for paid image generation or LLM calls (always behind a spend cap):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Web server settings (all optional; shown with their defaults). The server reads them from its environment at start-up, not from this file:
# GENKART_WARMUP=1            # 1: load the search model, catalogues and knowledge graph in the background at start-up; /api/ready answers 503 until done.
#                             # 0: nothing is loaded ahead and /api/ready answers 200 at once; the first search that needs the model pays for the load.
# GENKART_MAX_RUNS=4          # searches running at once (0 = none: every search answers 429 "busy")
# GENKART_RUN_WAIT_S=10       # seconds a search waits for a free run before answering 429 "busy"
# GENKART_RATE_PER_MIN=0      # searches per minute per visitor address (IPv6: per /64); 0 = no limit
# GENKART_STUDY_RATE_PER_MIN=60   # study consent, answers and withdrawals per minute per visitor address
