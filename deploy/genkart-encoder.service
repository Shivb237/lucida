[Unit]
Description=GenKart encoder (turns text into numbers)
After=network-online.target
Wants=network-online.target

[Service]
User=genkart
WorkingDirectory=/opt/genkart
Environment=PYTHONPATH=/opt/genkart/src
Environment=HF_HOME=/opt/genkart/.cache/huggingface
# ENCODER_CONCURRENCY lives here so a variant can be switched without rebuilding anything (the leading - means: fine if the file does not exist)
EnvironmentFile=-/etc/genkart/encoder.env
# listens on this machine only: only the router (same machine) talks to it
ExecStart=/opt/genkart/.venv/bin/python -m genkart.encoder_service --port 9000
Restart=always
RestartSec=3
TimeoutStartSec=600
# logs go to a FILE (CloudWatch reads plain JSON lines from files; from the journal they arrive wrapped in extra fields)
StandardOutput=append:/var/log/genkart/encoder.log
StandardError=append:/var/log/genkart/encoder.log
NoNewPrivileges=true
PrivateTmp=true
# sandbox: the whole file system is read-only for this service (the code and the venv belong to root), except the folders listed in
# ReadWritePaths; no home folders, no devices, no capabilities (it runs as genkart on ports above 1024 and needs none)
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
CapabilityBoundingSet=
# writes only the model download cache (HF_HOME, and torch's own cache, both under ~/.cache = /opt/genkart/.cache) and its log
ReadWritePaths=/opt/genkart/.cache /var/log/genkart
# no route to the instance metadata service: a hole in this program cannot borrow the machine's AWS role (it needs none)
IPAddressDeny=169.254.169.254

[Install]
WantedBy=multi-user.target
