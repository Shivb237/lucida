# Secrets: never commit. Keys live in .env (copy .env.example).
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Data and caches: downloaded or generated, never committed (dataset licences differ per source)
data/
.cache/
*.pkl
*.npy
*.parquet

# Throwaway runs
runs/smoke*
# Local-only scratch, failed, or superseded run records. They stay on disk; do not add them to a new public commit.
runs/aws-cw-test.jsonl
runs/aws-cw-test2.jsonl
runs/aws-dash.jsonl
runs/aws-demo-2026-10-16.jsonl
runs/aws-healthy.jsonl
